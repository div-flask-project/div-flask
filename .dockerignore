# ==============================================================================
# .dockerignore
# Docker 빌드 시 컨텍스트에서 제외할 파일 및 디렉토리 목록
# ==============================================================================

# 1. 가상환경 및 패키지 관리자
.venv/
venv/
ENV/
env/
node_modules/

# 2. 테스트 결과 및 E2E 리포트 (용량이 수백 MB에 달함)
test-results/
playwright-report/
tests/
screen/

# 3. 버전 관리 및 CI/CD
.git/
.github/
.gitignore

# 4. 파이썬 캐시 및 컴파일 파일
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 5. 문서 및 프레젠테이션/설계 파일
*.md
*.pptx
*.pdf

# 6. Node.js / Playwright 설정 파일
package.json
package-lock.json
playwright.config.js

# 7. Docker 자체 파일 및 환경설정 백업
Dockerfile
.dockerignore
.dockeringnore
*.log

